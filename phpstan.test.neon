includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: max
    tmpDir: build/phpstan-test
    treatPhpDocTypesAsCertain: false

    bootstrapFiles:
        - vendor/autoload.php

    scanDirectories:
        - phpstan

services:
    -
        class: Pekral\Arch\PHPStan\Rules\ActionInvokeMethodRule
        tags:
            - phpstan.rules.rule
    -
        class: Pekral\Arch\PHPStan\Rules\ActionClassModifiersRule
        tags:
            - phpstan.rules.rule
    -
        class: Pekral\Arch\PHPStan\Rules\ImmutableDependenciesRule
        tags:
            - phpstan.rules.rule
    -
        class: Pekral\Arch\PHPStan\Rules\NoMutableStaticStateRule
        tags:
            - phpstan.rules.rule
    -
        class: Pekral\Arch\PHPStan\Rules\NoPublicMutablePropertiesRule
        arguments:
            excludedClasses:
                - Pekral\Arch\Tests\Fixtures\PHPStan\NoPublicMutablePropertiesRule\Excluded\
                - Pekral\Arch\Tests\Fixtures\PHPStan\NoPublicMutablePropertiesRule\MutableStateAllowed
        tags:
            - phpstan.rules.rule
    -
        class: Pekral\Arch\PHPStan\Rules\NoManualArchitectureServiceInstantiationRule
        tags:
            - phpstan.rules.rule
    -
        class: Pekral\Arch\PHPStan\Rules\OnlyRepositoriesCanQueryDataRule
        tags:
            - phpstan.rules.rule
    -
        class: Pekral\Arch\PHPStan\Rules\ActionInvokeArgumentsRule
        tags:
            - phpstan.rules.rule
    -
        class: Pekral\Arch\PHPStan\Rules\NoDirectDatabaseQueriesInActionsRule
        tags:
            - phpstan.rules.rule
    -
        class: Pekral\Arch\PHPStan\Rules\ActionReturnDtoRule
        tags:
            - phpstan.rules.rule
    -
        class: Pekral\Arch\PHPStan\Rules\NoHttpResponseInActionsRule
        arguments:
            actionNamespaces:
                - Pekral\Arch\Tests\Fixtures\PHPStan\NoHttpResponseInActionsRule\Legacy\
        tags:
            - phpstan.rules.rule
    -
        class: Pekral\Arch\PHPStan\Rules\WhereRawBindingsRule
        tags:
            - phpstan.rules.rule
    -
        class: Pekral\Arch\PHPStan\Rules\NoHttpExceptionsInActionsRule
        arguments:
            actionNamespaces:
                - Pekral\Arch\Tests\Fixtures\PHPStan\NoHttpExceptionsInActionsRule\Legacy\
        tags:
            - phpstan.rules.rule
    -
        class: Pekral\Arch\PHPStan\Rules\NoHttpExceptionsInDataValidatorsRule
        arguments:
            dataValidatorNamespaces:
                - Pekral\Arch\Tests\Fixtures\PHPStan\NoHttpExceptionsInDataValidatorsRule\Validators\
        tags:
            - phpstan.rules.rule
    -
        class: Pekral\Arch\PHPStan\Rules\ActionsMustImplementArchActionRule
        arguments:
            actionNamespaces:
                - Pekral\Arch\Tests\Fixtures\PHPStan\ActionsMustImplementArchActionRule\Actions\
        tags:
            - phpstan.rules.rule
